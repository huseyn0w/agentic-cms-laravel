# react-i18next@16 / i18next@25 declare an OPTIONAL, type-check-only peer on
# typescript ^5||^6, while this project pins TypeScript 7. The peer has no
# runtime effect, but npm still hard-errors on the optional-peer mismatch, and
# CI runs `npm ci`. Accept the optional-peer skew project-wide so install is
# consistent locally and in CI. Revisit once react-i18next widens its TS peer.
legacy-peer-deps=true
