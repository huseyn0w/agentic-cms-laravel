APP_NAME=AgenticCms-Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack

# Database (MySQL 8 is the documented default for local + Hostinger).
#   - Hostinger (production, no Docker): DB_HOST=localhost
#   - Local Docker Compose:              DB_HOST=mysql  (the compose service name)
# The same keys work in both environments; only DB_HOST differs.
# Tests use SQLite in-memory automatically (see phpunit.xml) - no DB setup needed.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=agentic_cms_laravel
# NOTE: the MySQL image forbids "root" as MYSQL_USER — use a dedicated app user.
DB_USERNAME=agentic_cms_laravel
DB_PASSWORD=secret
# Used only by the local Docker MySQL service (docker-compose.yml); ignored on Hostinger.
DB_ROOT_PASSWORD=rootsecret

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=database
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@agentic-cms-laravel.local"
MAIL_FROM_NAME="${APP_NAME}"

# Media storage driver (FEATURE_MATRIX §7 — swappable storage).
# All media uploads/reads route through the disk named here (config/lfm.php).
#   MEDIA_DISK=public  -> local disk, media served from /uploads (default)
#   MEDIA_DISK=s3      -> S3 / CDN, using the AWS_* vars below (drop-in swap)
MEDIA_DISK=public

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
# Optional CDN/base URL for the S3 disk (leave empty to use the bucket URL).
AWS_URL=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

TEMPLATE_NAME=default

LOCALE=en

# Google reCAPTCHA (https://www.google.com/recaptcha/admin)
# Leave keys empty to disable captcha entirely (local/dev/test): forms render
# without a widget and captcha validation always passes.
# Set CAPTCHA_ENABLED=true and provide both keys to enforce it in production.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
CAPTCHA_ENABLED=false

CONTACT_EMAIL=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://agentic-cms-laravel.loc/login/google/callback


# --- Core updates (WordPress-style in-admin core update) ---
# Feed URL listing available releases (empty disables update checks). A tier-1
# fleet site points this at core's releases; a tier-2 fork at its own feed.
CMS_UPDATE_CHANNEL=
# Base64 Ed25519 public key that release signatures are verified against.
# A valid signature is MANDATORY in production. Its secret half lives in the
# release repo's CI secret CMS_RELEASE_SIGN_KEY (never on a running site).
CMS_UPDATE_PUBLIC_KEY=
# When true (and composer is reachable), run `composer install` after applying
# instead of trusting the vendor/ shipped in the release. Off by default.
CMS_UPDATE_INSTALL_COMPOSER=false
# Background availability check cadence: hourly | daily.
CMS_UPDATE_CHECK_SCHEDULE=daily
